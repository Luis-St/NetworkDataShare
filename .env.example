# Copy to .env and adjust, see ./network-data-share --help or the README for the meaning of each value.

# Address and port to listen on.
NDS_BIND=0.0.0.0:8080
# Seconds until an unanswered share invite expires.
NDS_INVITE_TIMEOUT=60
# Seconds a disconnected client may take to reconnect before its sessions end.
NDS_RECONNECT_GRACE=60
# Maximum number of clients (browser tabs) per IP address.
NDS_MAX_CLIENTS_PER_IP=32

# Serve plain HTTP instead of HTTPS, set to true to enable.
# NDS_HTTP=true

# Own certificate instead of the generated self-signed one, paths inside the container.
# Mount the files into the container in compose.yaml when using these.
# NDS_CERT=/certs/cert.pem
# NDS_KEY=/certs/key.pem
